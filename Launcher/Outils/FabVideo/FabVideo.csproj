<Project Sdk="Microsoft.NET.Sdk">

  <!-- Outil de test du fond animé : fabrique une vidéo H.264 dont chaque image code son numéro (encodeur de Windows,
       MediaComposition, par les .winmd du système ; rien à télécharger). Voir Program.cs et Docs/launcher.md.
       Construire : dotnet build -c Release Launcher/Outils/FabVideo, puis bin/Release/net48/FabVideo.exe sortie.mp4 60 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(SystemRoot)\System32\WinMetadata\Windows.Foundation.winmd" Private="false" />
    <Reference Include="$(SystemRoot)\System32\WinMetadata\Windows.Media.winmd" Private="false" />
    <Reference Include="$(SystemRoot)\System32\WinMetadata\Windows.Storage.winmd" Private="false" />
    <Reference Include="System.Runtime" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
