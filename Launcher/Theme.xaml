<!-- Thème du launcher : les jetons de Assets/UI/Theme/Deathless.uss (préfixe dl-), ramenés à l'échelle des maquettes
     (canevas 1280 × 720, soit les valeurs de l'USS divisées par 1,5). La fenêtre est dessinée à cette échelle puis
     agrandie ou réduite en bloc, comme le panneau UI Toolkit du jeu. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Police du jeu, embarquée dans l'exe (Fredoka Regular, Medium, SemiBold, Bold ; licence OFL, voir OFL.txt). -->
    <FontFamily x:Key="Fredoka">pack://application:,,,/Polices/#Fredoka</FontFamily>

    <!-- Couleurs (dl-color-*) -->
    <Color x:Key="CouleurEncre">#161a24</Color>
    <SolidColorBrush x:Key="Encre" Color="#161a24" />             <!-- ink : fond -->
    <SolidColorBrush x:Key="Creux" Color="#10131b" />             <!-- well : creux des jauges -->
    <SolidColorBrush x:Key="Panneau95" Color="#F2232a3a" />       <!-- panel-95 : panneau posé sur la scène -->
    <SolidColorBrush x:Key="PanneauActif" Color="#2b3348" />
    <SolidColorBrush x:Key="Bord" Color="#3d4660" />
    <SolidColorBrush x:Key="BordFort" Color="#56607c" />
    <SolidColorBrush x:Key="Ligne" Color="#333b52" />
    <SolidColorBrush x:Key="Barre" Color="#EB10131b" />           <!-- bar : barre d'invites, 0,92 -->
    <SolidColorBrush x:Key="Volet" Color="#ED10131b" />           <!-- menu__volet : rgba(16, 19, 27, 0.93) -->
    <SolidColorBrush x:Key="FondJauges" Color="#C710131b" />      <!-- hud-joueur__jauges : rgba(16, 19, 27, 0.78) -->
    <SolidColorBrush x:Key="Texte" Color="#f4ecd8" />             <!-- ivoire -->
    <SolidColorBrush x:Key="TexteSecondaire" Color="#c3bca9" />
    <SolidColorBrush x:Key="TexteInactif" Color="#8a8578" />
    <SolidColorBrush x:Key="Or" Color="#d9b264" />
    <SolidColorBrush x:Key="Alerte" Color="#ff9a8a" />            <!-- hud-alerte-bouclier -->

    <!-- Panneau dl-panel : fond panel-95, trait de 1 px, rayon lg (14), marges 16 × 24. -->
    <Style x:Key="PanneauDl" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panneau95}" />
        <Setter Property="BorderBrush" Value="{StaticResource Bord}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="24,16,16,16" />
    </Style>

    <!-- Barre de défilement du thème (unity-scroller, vertical) : fine, creux sombre, poignée bord-fort arrondie. -->
    <Style x:Key="BarreDefilement" TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{StaticResource Creux}" CornerRadius="4">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Poignee" Background="{StaticResource BordFort}" CornerRadius="4" MinHeight="24" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Poignee" Property="Background" Value="{StaticResource TexteSecondaire}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Poignee" Property="Background" Value="{StaticResource Or}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="DefilementDl" TargetType="ScrollViewer">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="0,0,14,0"
                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource BarreDefilement}"
                       Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
