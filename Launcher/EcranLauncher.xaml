<!-- Écran du launcher, calqué sur le menu principal du jeu (Assets/UI/Screens/MenuPrincipal/MenuPrincipal.uxml et
     V01.uss) : la scène du village de nuit en fond, volet gauche assombri avec DEATHLESS et le sous-titre, entrées de
     menu (Jouer, Réessayer, Quitter), jauge de téléchargement en barre de vie, notes de version dans un panneau
     dl-panel à droite, barre d'invites en bas. Toutes les mesures sont celles des maquettes 1280 × 720 ; le calque
     est mis à l'échelle de la fenêtre (EcranLauncher.xaml.cs, Echelle). -->
<UserControl x:Class="DeathlessLauncher.EcranLauncher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeathlessLauncher"
             FontFamily="{StaticResource Fredoka}" Foreground="{StaticResource Texte}" FontSize="16"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal">
    <Grid x:Name="Racine" Background="{StaticResource Encre}" ClipToBounds="True">
        <!-- Fond animé (fond.mp4 à côté de l'exe), SOUS l'image fixe : il se prépare caché, puis l'image fixe (qui est
             son image 0) est retirée. Absent ou illisible : l'image fixe reste. Voir Docs/launcher.md, « Changer le fond ». -->
        <local:FondVideo x:Name="Video" />
        <!-- Image fixe : l'image 0 de la vidéo (fond0.png) quand il y a une vidéo, sinon la scène du menu principal. -->
        <Image x:Name="Fond" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Grid x:Name="Calque">
            <!-- menu__volet : 810 px à 1080p -->
            <Border Width="540" HorizontalAlignment="Left" Background="{StaticResource Volet}" />

            <!-- menu__titres -->
            <StackPanel Margin="72,72,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <local:TexteEspace Text="DEATHLESS" FontSize="68" FontWeight="Bold" Espacement="2.7" />
                <TextBlock Text="Défendre Nyxessa, de jour comme de nuit" FontSize="17.5" Foreground="{StaticResource Or}" Margin="2,0,0,0" />
            </StackPanel>

            <!-- menu__liste -->
            <StackPanel x:Name="Liste" Margin="60,228,0,0" Width="400" HorizontalAlignment="Left" VerticalAlignment="Top">
                <local:EntreeMenu x:Name="EntreeJouer" Libelle="Jouer" Description="Démarrage…" />
                <local:EntreeMenu x:Name="EntreeReessayer" Libelle="Réessayer" Description="Relancer la mise à jour" Visibility="Collapsed" />
                <local:EntreeMenu x:Name="EntreeWiki" Libelle="Wiki" Description="Règles, classes et commandes" Visibility="Collapsed" />
                <local:EntreeMenu x:Name="EntreeQuitter" Libelle="Quitter" Description="Fermer le launcher" />
            </StackPanel>

            <!-- Jauge de téléchargement, dans le cadre des jauges du HUD (hud-joueur__jauges). -->
            <Border Margin="60,0,0,84" Width="400" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Background="{StaticResource FondJauges}" CornerRadius="12" Padding="14,10,14,12">
                <StackPanel>
                    <!-- Rafraîchir (F5, X) : à droite de la jauge, quand le jeu est à jour. -->
                    <DockPanel>
                        <local:BoutonRafraichir x:Name="BoutonRafraichir" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                                                Margin="10,0,0,-5" Visibility="Collapsed" />
                        <local:JaugeVie x:Name="Jauge" />
                    </DockPanel>
                    <TextBlock x:Name="Message" FontSize="14" Foreground="{StaticResource Alerte}" TextWrapping="Wrap"
                               Margin="0,8,0,0" MaxHeight="60" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Notes de version : dl-panel. Replié par défaut (carte en haut à droite, sur les arbres : Nyxessa et le
                 portail restent dégagés) : titre, version, étiquette et titre de la version. Déplié : toute la hauteur,
                 liste complète. Bascule par N / Y ou un clic (EcranLauncher.xaml.cs, BasculerNotes). -->
            <Border x:Name="PanneauNotes" Style="{StaticResource PanneauDl}" Width="430" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,48,44,84" Cursor="Hand">
                <DockPanel>
                    <Grid x:Name="EnteteNotes" DockPanel.Dock="Top" Margin="0,2,0,12" Background="Transparent">
                        <local:TexteEspace Text="NOTES DE VERSION" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                                           Espacement="1.4" Foreground="{StaticResource Or}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Image x:Name="InviteNotesCarte" Width="24" Height="24" Margin="0,-6,6,-6" />
                            <!-- Chevron low poly, or plein, bords francs : vers le bas replié, vers le haut déplié. -->
                            <Polygon x:Name="Chevron" Points="0,0 12,0 6,7" Fill="{StaticResource Or}" VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5" Margin="0,1,0,0">
                                <Polygon.RenderTransform>
                                    <RotateTransform x:Name="RotationChevron" Angle="0" />
                                </Polygon.RenderTransform>
                            </Polygon>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="Defilement" Template="{StaticResource DefilementDl}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False" CanContentScroll="False">
                        <StackPanel x:Name="ListeNotes" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- dl-prompt-bar -->
            <Border VerticalAlignment="Bottom" Height="56" Background="{StaticResource Barre}"
                    BorderBrush="{StaticResource Bord}" BorderThickness="0,1,0,0" Padding="40,0">
                <DockPanel>
                    <TextBlock x:Name="NomAppareil" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="14"
                               Foreground="{StaticResource TexteSecondaire}" Text="Clavier et souris" />
                    <!-- Version du launcher (pas celle du jeu), discrète, avant l'appareil actif. -->
                    <TextBlock x:Name="VersionLauncher" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource TexteInactif}" Margin="0,0,24,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="InviteValider" Width="32" Height="32" />
                        <TextBlock Text="Valider" VerticalAlignment="Center" Margin="8,0,28,0" />
                        <Image x:Name="InviteChoisir" Width="32" Height="32" />
                        <TextBlock Text="Choisir" VerticalAlignment="Center" Margin="8,0,28,0" />
                        <Image x:Name="InviteNotes" Width="32" Height="32" />
                        <TextBlock Text="Notes de version" VerticalAlignment="Center" Margin="8,0,28,0" />
                        <StackPanel x:Name="InviteRafraichirGroupe" Orientation="Horizontal" Visibility="Collapsed">
                            <Image x:Name="InviteRafraichir" Width="32" Height="32" />
                            <TextBlock Text="Rafraîchir" VerticalAlignment="Center" Margin="8,0,28,0" />
                        </StackPanel>
                        <StackPanel x:Name="InviteDefilerGroupe" Orientation="Horizontal" Visibility="Collapsed">
                            <Image x:Name="InviteDefiler" Width="32" Height="32" />
                            <TextBlock Text="Défiler" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
