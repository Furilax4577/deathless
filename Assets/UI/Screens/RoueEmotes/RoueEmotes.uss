/* Roue à emotes (calque du HUD, Deathless.UI.Ecrans.CalqueRoueEmotes). Conçue pour ×2 (1920 × 1080) ; les tailles
   ×1 / ×3 passent par l'échelle du panneau (UIScale), la roue est resserrée à ×3. */

.roue {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(16, 19, 27, 0.28);   /* voile léger : le jeu reste visible */
}

.roue__disque {
    width: 720px;
    height: 720px;
    flex-shrink: 0;
}

/* Anneau de secteurs dessiné par FondRoueEmotes : couleurs tirées des jetons du thème. */
.roue__fond {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --roue-fond: var(--dl-color-panel-95);
    --roue-fond-pointe: var(--dl-color-panel-active);
    --roue-bord: var(--dl-color-border);
    --roue-bord-pointe: var(--dl-color-gold);
    --roue-trou: 0.36;
}

.roue__secteurs {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Case d'un secteur : centrée sur son point (left / top posés par le code). */
.roue__case {
    position: absolute;
    width: 180px;
    translate: -50% -50%;
    align-items: center;
}

.roue__icone {
    width: 72px;
    height: 72px;
    margin-bottom: var(--dl-space-1);
    opacity: 0.85;
}

.roue__case-nom {
    font-size: var(--dl-text-body);
    color: var(--dl-color-text-muted);
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0;
    margin: 0;
}

.roue__case--pointee .roue__icone {
    opacity: 1;
    scale: 1.15 1.15;
}

.roue__case--pointee .roue__case-nom {
    color: var(--dl-color-gold);
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
}

/* Centre : titre, nom de l'emote pointée (ou « Annuler »), invite de la touche. */
.roue__centre {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 240px;
    height: 240px;
    translate: -50% -50%;
    border-radius: 120px;
    border-width: var(--dl-border);
    border-color: var(--dl-color-border);
    background-color: var(--dl-color-panel-95);
    align-items: center;
    justify-content: center;
    padding: var(--dl-space-2);
}

.roue__titre {
    font-size: var(--dl-text-caption);
    margin-bottom: var(--dl-space-1);
}

.roue__nom {
    font-size: var(--dl-text-large);
    color: var(--dl-color-text);
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0 0 var(--dl-space-1) 0;
    padding: 0;
}

.roue__nom--annuler { color: var(--dl-color-text-muted); }

.roue__invite {
    flex-direction: row;
    align-items: center;
}

.roue__aide {
    font-size: var(--dl-text-caption);
    color: var(--dl-color-text-muted);
    margin: 0 0 0 var(--dl-space-1);
    padding: 0;
}

/* ×3 : moins de 800 unités de haut à l'écran, la roue est resserrée (le texte courant garde sa taille). */
.dl-scale-3 .roue__disque { width: 640px; height: 640px; }
.dl-scale-3 .roue__case { width: 160px; }
.dl-scale-3 .roue__icone { width: 60px; height: 60px; }
.dl-scale-3 .roue__centre { width: 220px; height: 220px; border-radius: 110px; }
