<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:dl="Deathless.UI" editor-extension-mode="False">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <!-- Pseudos des autres joueurs au-dessus de leur tête (multijoueur ; construits par EcranHud) -->
        <ui:VisualElement name="pseudos" class="hud-pseudos" picking-mode="Ignore" />
        <!-- Statuts au-dessus des ennemis affectés (placés chaque image par HudStatuts) -->
        <ui:VisualElement name="statuts-ennemis" class="hud-statuts-ennemis" picking-mode="Ignore" />

        <!-- Mort : voile et compte à rebours (sous le reste du HUD) -->
        <ui:VisualElement name="mort" class="hud-mort" picking-mode="Ignore">
            <ui:Label text="Vous êtes tombé" class="dl-display hud-mort__titre" />
            <ui:Label name="mort-texte" text="Réapparition dans 8 s" class="hud-mort__texte" />
            <ui:Label text="Tant que Nyxessa tient, vous revenez au village." class="dl-text dl-text--muted hud-mort__aide" />
        </ui:VisualElement>

        <!-- Centre : réticule et action possible -->
        <dl:Reticule name="reticule" class="hud-reticule" />
        <ui:VisualElement name="interaction" class="hud-pastille hud-interaction" picking-mode="Ignore">
            <dl:InputPrompt action="Gameplay/Interact" class="dl-prompt--small" />
            <ui:Label name="interaction-texte" text="Parler au sorcier" class="hud-interaction__texte" />
        </ui:VisualElement>

        <!-- Haut, au centre : Nyxessa, bouclier, temps, vote, alertes -->
        <ui:VisualElement name="haut" class="hud-haut" picking-mode="Ignore">
            <ui:VisualElement class="hud-nyx">
                <dl:GemmeNyxessa class="hud-nyx__gemme" />
                <ui:VisualElement class="hud-nyx__barre">
                    <ui:VisualElement class="hud-nyx__piste-vie">
                        <ui:VisualElement name="nyx-vie" class="hud-nyx__vie" />
                    </ui:VisualElement>
                    <ui:VisualElement name="nyx-piste-bouclier" class="hud-nyx__piste-bouclier">
                        <ui:VisualElement name="nyx-bouclier" class="hud-nyx__bouclier" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Missiles de Nyxessa : icône éteinte, icône allumée découpée du bas vers le haut selon la recharge, « 3 / 5 » -->
                <ui:VisualElement name="missiles" class="hud-missiles" picking-mode="Ignore">
                    <ui:VisualElement name="missiles-icone" class="hud-missiles__icone" picking-mode="Ignore">
                        <ui:VisualElement name="missiles-onde" class="hud-missiles__onde" picking-mode="Ignore" />
                        <ui:VisualElement name="missiles-eteint" class="dl-icone hud-missiles__eteint" picking-mode="Ignore" />
                        <ui:VisualElement name="missiles-charge" class="hud-missiles__charge" picking-mode="Ignore">
                            <ui:VisualElement name="missiles-plein" class="dl-icone hud-missiles__plein" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="missiles-nombre" text="3" class="hud-missiles__nombre" />
                    <ui:Label name="missiles-max" text="/ 5" class="hud-missiles__max" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hud-pastille hud-temps">
                <dl:IconeJourNuit name="temps-icone" class="hud-temps__icone" />
                <ui:Label name="temps-texte" text="Jour · 1:42 avant la nuit" class="hud-temps__texte" />
                <ui:VisualElement name="prets" class="hud-prets">
                    <ui:Label name="prets-texte" text="Prêts 0 / 1" class="hud-prets__texte" />
                    <dl:InputPrompt action="Gameplay/Ready" class="dl-prompt--small" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="alerte-bouclier" text="Bouclier de Nyxessa à 32 %" class="hud-alerte-bouclier" />
            <ui:VisualElement name="alerte-nuit" class="hud-pastille hud-alerte-nuit">
                <dl:IconeJourNuit nuit="true" class="hud-temps__icone" />
                <ui:Label name="alerte-nuit-texte" text="La nuit tombe dans 15 s" class="hud-alerte-nuit__texte" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bannière de début de nuit -->
        <ui:VisualElement name="banniere" class="hud-banniere" picking-mode="Ignore">
            <ui:Label name="banniere-titre" text="NUIT 1" class="hud-banniere__titre" />
            <ui:Label text="Tenez jusqu’à l’aube" class="hud-banniere__sous-titre" />
        </ui:VisualElement>

        <!-- Indicateur de bord d'écran -->
        <ui:VisualElement name="attaque" class="hud-attaque hud-attaque--gauche" picking-mode="Ignore">
            <dl:FlecheHud name="attaque-fleche" angle="180" class="hud-attaque__fleche" />
            <ui:Label text="Nyxessa attaquée" class="hud-attaque__texte" />
        </ui:VisualElement>

        <!-- Haut, à droite : or de l'équipe -->
        <ui:VisualElement class="hud-pastille hud-or">
            <dl:PieceOr class="hud-or__piece" />
            <ui:Label name="or-valeur" text="0" class="hud-or__valeur" />
            <ui:Label text="caisse commune" class="hud-or__legende" />
        </ui:VisualElement>

        <!-- Gauche, à mi-hauteur : vie des autres joueurs (multijoueur, jusqu'à 3 ; vide en solo ; construite par EcranHud) -->
        <ui:VisualElement name="allies" class="hud-allies" picking-mode="Ignore" />

        <!-- Haut, à droite, sous la caisse : or porté (ramassé au donjon, versé à la caisse au retour) -->
        <ui:VisualElement name="or-porte" class="hud-pastille hud-or-porte" picking-mode="Ignore">
            <dl:PieceOr class="hud-or__piece" />
            <ui:Label name="or-porte-valeur" text="0" class="hud-or__valeur" />
            <ui:Label name="or-porte-legende" text="or porté" class="hud-or__legende" />
        </ui:VisualElement>
        <!-- Haut, au centre : alerte du donjon (rappel par Nyxessa) et message (rappel, dépôt) -->
        <ui:VisualElement name="donjon-alerte" class="hud-pastille hud-donjon-alerte" picking-mode="Ignore">
            <ui:Label name="donjon-alerte-texte" text="Le portail se ferme dans 15 s : rentrez !" class="hud-donjon-alerte__texte" />
        </ui:VisualElement>
        <ui:VisualElement name="donjon-message" class="hud-pastille hud-donjon-message" picking-mode="Ignore">
            <ui:Label name="donjon-message-texte" text="Message" class="hud-donjon-message__texte" />
        </ui:VisualElement>

        <!-- Bas, à gauche, au-dessus du portrait et des barres : statuts du joueur (brûlure, ralenti… ; HudStatuts) -->
        <ui:VisualElement name="statuts" class="hud-statuts" picking-mode="Ignore" />

        <!-- Bas, à gauche, au-dessus du joueur : points de compétence à dépenser (menu du personnage) -->
        <ui:VisualElement name="points-competence" class="hud-pastille hud-points" picking-mode="Ignore">
            <ui:Label name="points-texte" text="1 point de compétence" class="hud-points__texte" />
            <dl:InputPrompt action="Gameplay/CharacterMenu" class="hud-points__invite" />
        </ui:VisualElement>

        <!-- Bas, à gauche : portrait, vie, endurance -->
        <ui:VisualElement class="hud-joueur">
            <ui:VisualElement name="portrait" class="hud-joueur__portrait">
                <ui:VisualElement name="portrait-embleme" class="dl-icone hud-joueur__embleme" />
                <ui:Label name="portrait-initiale" text="P" class="hud-joueur__initiale" />
                <ui:VisualElement name="furtif" class="hud-joueur__furtif" tooltip="Furtif">
                    <ui:VisualElement name="furtif-icone" class="dl-icone hud-joueur__furtif-icone" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hud-joueur__jauges">
                <dl:Gauge name="joueur-vie" label="Vie" value="100" max="100" class="dl-gauge--life" />
                <dl:Gauge name="joueur-endurance" label="Endurance" value="100" max="100" class="dl-gauge--stamina dl-gauge--thin" />
                <dl:Gauge name="joueur-jauge" label="Mana" value="100" max="100" class="dl-gauge--mana dl-gauge--thin hud-joueur__jauge-classe" />
            </ui:VisualElement>
            <ui:VisualElement name="potion" class="hud-potion" picking-mode="Ignore">
                <ui:VisualElement class="hud-potion__case">
                    <ui:VisualElement name="potion-icone" class="dl-icone hud-potion__icone" />
                    <ui:Label name="potion-nombre" text="2" class="hud-potion__nombre" />
                </ui:VisualElement>
                <dl:InputPrompt action="Gameplay/DrinkPotion" class="hud-emplacement__invite" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bas, au centre : compétences (construites par EcranHud) -->
        <ui:VisualElement name="competences" class="hud-competences" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
