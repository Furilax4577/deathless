/* HUD en jeu (version 0.1). Valeurs des maquettes HUD_Jour / HUD_Nuit × 1,5. */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-pastille {
    flex-direction: row;
    align-items: center;
    height: 51px;
    padding: 0 21px;
    border-radius: 26px;
    background-color: rgba(16, 19, 27, 0.88);
}

/* ---------- Haut, au centre ---------- */
.hud-haut {
    position: absolute;
    top: 30px;
    left: 50%;
    width: 900px;   /* 780 avant le compteur de missiles : la barre de Nyxessa garde sa longueur */
    translate: -50% 0;
    align-items: center;
}

.hud-nyx { flex-direction: row; align-items: center; width: 100%; margin-bottom: 12px; }
.hud-nyx__gemme { width: 33px; height: 42px; margin-right: 15px; }

.hud-nyx__barre {
    flex-grow: 1;
    height: 27px;
    border-radius: 13px;
    border-width: 1px;
    border-color: var(--dl-color-border);
    background-color: var(--dl-color-well);
    overflow: hidden;
}

.hud-nyx__piste-vie { flex-grow: 2; }
.hud-nyx__vie { height: 100%; width: 100%; background-color: var(--dl-color-nyxessa); }
.hud-nyx__piste-bouclier { flex-grow: 1; background-color: rgba(0, 0, 0, 0.35); }
.hud-nyx__bouclier { height: 100%; width: 100%; background-color: var(--dl-color-shield); }
.hud-nyx__bouclier--entame { background-color: var(--dl-color-shield-warn); }
.hud-nyx__bouclier--critique { background-color: var(--dl-color-life); }

/* Missiles de Nyxessa (à droite de la barre) : l'icône allumée monte du bas vers le haut pendant la recharge du
   prochain missile, par-dessus sa version éteinte ; stock plein : icône entière et liseré vert. Vert permis : Nyxessa. */
.hud-missiles {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 42px;
    margin-left: 15px;
    padding: 0 15px 0 3px;
    border-radius: 21px;
    border-width: 1px;
    border-color: var(--dl-color-border);
    background-color: rgba(16, 19, 27, 0.78);
    display: none;
}
.hud-missiles--plein { border-color: rgba(63, 174, 90, 0.75); }
.hud-missiles__icone { width: 42px; height: 42px; flex-shrink: 0; }
.hud-missiles__eteint { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hud-missiles__charge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    overflow: hidden;
    border-top-width: 2px;
    border-top-color: rgba(164, 236, 144, 0.6);
}
.hud-missiles__charge--pleine { border-top-width: 0; }
/* Taille fixe, ancrée en bas : l'icône ne se déforme pas quand la découpe rétrécit. */
.hud-missiles__plein { position: absolute; left: 0; bottom: 0; width: 42px; height: 42px; }
/* Onde d'un tir : anneau qui s'élargit et s'efface (opacité et échelle posées par EcranHud). */
.hud-missiles__onde {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    border-width: 3px;
    border-color: #a4ec90;
    opacity: 0;
}
.hud-missiles__nombre {
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
    font-size: var(--dl-text-body);
    color: var(--dl-color-text);
    margin: 0 0 0 9px;
    padding: 0;
}
.hud-missiles__max { font-size: var(--dl-text-small); color: var(--dl-color-text-muted); margin: 0 0 0 6px; padding: 0; }
.hud-missiles--vide .hud-missiles__nombre { color: var(--dl-color-text-disabled); }
.hud-missiles--tir .hud-missiles__nombre { color: #a4ec90; }

.hud-temps__icone { width: 27px; height: 27px; margin-right: 15px; }
.hud-temps__texte { font-size: var(--dl-text-body); margin: 0; padding: 0; }

.hud-prets { flex-direction: row; align-items: center; margin-left: 18px; }
.hud-prets__texte { font-size: var(--dl-text-small); color: var(--dl-color-text-muted); margin: 0 9px 0 0; padding: 0; }

.hud-alerte-bouclier {
    font-size: var(--dl-text-small);
    color: #ff9a8a;
    margin: 9px 0 0 0;
    padding: 0;
}

.hud-alerte-nuit {
    margin-top: 12px;
    border-width: 2px;
    border-color: var(--dl-color-shield-warn);
    background-color: rgba(58, 36, 16, 0.88);
}

.hud-alerte-nuit--pulse { border-color: #ffd166; background-color: rgba(96, 58, 20, 0.92); }
.hud-alerte-nuit__texte {
    font-size: var(--dl-text-body);
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
    color: #ffd9a0;
    margin: 0;
    padding: 0;
}

/* ---------- Bannière NUIT N ---------- */
.hud-banniere {
    position: absolute;
    left: 0;
    right: 0;
    top: 225px;
    align-items: center;
    opacity: 0;
    scale: 0.92 0.92;
    transition-property: opacity, scale;
    transition-duration: 0.5s, 0.5s;
}

.hud-banniere--visible { opacity: 1; scale: 1 1; }

.hud-banniere__titre {
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-Bold-SDF.asset");
    font-size: 96px;
    letter-spacing: 9px;
    color: var(--dl-color-text);
    margin: 0;
    padding: 0;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.6);
}

.hud-banniere__sous-titre {
    font-size: var(--dl-text-large);
    color: var(--dl-color-gold);
    margin: 0;
    padding: 0;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
}

/* ---------- Nyxessa attaquée (bord de l'écran) ---------- */
.hud-attaque {
    position: absolute;
    flex-direction: row;
    align-items: center;
    height: 60px;
    padding: 0 21px 0 12px;
    border-radius: 30px;
    background-color: rgba(200, 53, 44, 0.9);
}

.hud-attaque--gauche { left: 24px; }
.hud-attaque--droite { right: 24px; flex-direction: row-reverse; padding: 0 12px 0 21px; }
.hud-attaque--haut { top: 290px; left: 50%; translate: -50% 0; }
.hud-attaque--bas { bottom: 250px; left: 50%; translate: -50% 0; }
.hud-attaque__fleche { width: 33px; height: 33px; margin: 0 9px; }
.hud-attaque__texte {
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
    font-size: 22px;
    color: #ffffff;
    margin: 0;
    padding: 0;
}

/* ---------- Or (haut, à droite) ---------- */
.hud-or { position: absolute; right: 48px; top: 33px; height: 60px; border-radius: 30px; }
.hud-or__piece { width: 33px; height: 33px; margin-right: 15px; }
.hud-or__valeur {
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
    font-size: var(--dl-text-large);
    margin: 0 12px 0 0;
    padding: 0;
}
.hud-or__legende { font-size: var(--dl-text-small); color: var(--dl-color-text-muted); margin: 0; padding: 0; }

/* ---------- Autres joueurs (gauche, à mi-hauteur ; multijoueur) ---------- */
.hud-allies { position: absolute; left: 48px; top: 40%; width: 312px; }
.hud-allie {
    flex-direction: row;
    align-items: center;
    height: 63px;
    padding: 0 21px 0 9px;
    margin-bottom: 9px;
    border-radius: 32px;
    background-color: rgba(16, 19, 27, 0.78);
}
.hud-allie__embleme { width: 45px; height: 45px; margin-right: 12px; flex-shrink: 0; }
.hud-allie__corps { flex-grow: 1; flex-shrink: 1; justify-content: center; overflow: hidden; }
.hud-allie__pseudo {
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
    font-size: var(--dl-text-small);
    color: var(--dl-color-text);
    margin: 0;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.hud-allie__piste { height: 8px; margin-top: 6px; border-radius: 4px; background-color: var(--dl-color-well); overflow: hidden; }
.hud-allie__vie { height: 100%; width: 100%; background-color: var(--dl-color-life); }
.hud-allie__etat { font-size: var(--dl-text-caption); color: var(--dl-color-text-muted); margin: 2px 0 0 0; padding: 0; display: none; }
/* Allié mort : ligne grisée, compte à rebours à la place de la barre. */
.hud-allie--mort { background-color: rgba(16, 19, 27, 0.6); }
.hud-allie--mort .hud-allie__embleme { opacity: 0.35; }
.hud-allie--mort .hud-allie__pseudo { color: var(--dl-color-text-muted); }
.hud-allie--mort .hud-allie__piste { display: none; }
.hud-allie--mort .hud-allie__etat { display: flex; }

/* Pseudos au-dessus des têtes (placés chaque image par EcranHud) */
.hud-pseudos { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hud-pseudo {
    position: absolute;
    translate: -50% -100%;
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
    font-size: var(--dl-text-small);
    color: var(--dl-color-text);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--dl-color-ink);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

/* ---------- Joueur (bas, à gauche) ---------- */
.hud-joueur {
    position: absolute;
    left: 48px;
    bottom: 39px;
    flex-direction: row;
    align-items: flex-end;
}

/* Emplacement du portrait : la boîte du dessous accueille l'anneau de jauge de classe (mana/rage), qui déborde
   légèrement autour du portrait. Pas de classe sans jauge : l'anneau reste masqué (EcranHud.MajClasse). */
.hud-joueur__portrait-emplacement { position: relative; width: 132px; height: 132px; margin-right: 21px; flex-shrink: 0; }
.hud-joueur__anneau { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; }

/* Pas de rond derrière l'emblème (Quentin, 26/09/2026 : « l'hexa est déjà super propre ») : l'emblème hexagonal
   est posé tel quel dans l'anneau de mana/rage ; le fond teinté ne sert qu'au repli sur l'initiale. */
.hud-joueur__portrait {
    position: absolute;
    left: 14px;
    top: 14px;
    right: 14px;
    bottom: 14px;
    align-items: center;
    justify-content: center;
}

.hud-joueur__initiale {
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-Bold-SDF.asset");
    font-size: 40px;
    color: var(--dl-color-ink);
    margin: 0;
    padding: 0;
}

/* Emblème hexagonal de la classe dans le portrait (Quentin, 26/09/2026) ; l'initiale ne sert plus que de repli. */
.hud-joueur__embleme { width: 100%; height: 100%; display: none; }

.hud-joueur__furtif { position: absolute; right: -15px; top: -15px; width: 54px; height: 54px; border-radius: 27px; background-color: #2b1840; border-width: 2px; border-color: #5b3a8a; display: none; align-items: center; justify-content: center; }
.hud-joueur__furtif-icone { width: 40px; height: 40px; }
.hud-potion { align-items: center; margin-left: 15px; display: none; }
.hud-potion__case { width: 72px; height: 72px; border-radius: 15px; border-width: 3px; border-color: var(--dl-color-border-strong); background-color: var(--dl-color-panel); align-items: center; justify-content: center; margin-bottom: 9px; }
.hud-potion__icone { position: absolute; left: 9px; top: 9px; right: 9px; bottom: 9px; }
.hud-potion__nombre { position: absolute; right: 3px; bottom: 0; margin: 0; padding: 0 3px; -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-Bold-SDF.asset"); font-size: 24px; color: #ffffff; -unity-text-outline-width: 1px; -unity-text-outline-color: var(--dl-color-ink); }
.hud-potion--vide .hud-potion__icone { opacity: 0.35; }
.hud-emplacement--vide .hud-emplacement__case { border-color: var(--dl-color-line); background-color: rgba(16, 19, 27, 0.5); }
.hud-emplacement--vide .hud-emplacement__abrev { color: var(--dl-color-text-disabled); }
.hud-emplacement--vide .hud-emplacement__invite { opacity: 0.35; }

/* Colonne à droite du portrait : statuts, vie (large, embouts de gemme, seule à afficher son chiffre), endurance
   (filet qui ne s'éclaire vraiment que sous 70 %, EcranHud.MajJoueur). Pas de libellé « Vie »/« Endurance »/« Mana »,
   pas d'icône à côté des barres (maquette B). */
.hud-joueur__colonne { align-items: flex-start; }

.hud-joueur__vie-ligne { flex-direction: row; align-items: center; }
.hud-joueur__gemme {
    width: 15px;
    height: 15px;
    rotate: 45deg;
    border-radius: 3px;
    background-color: var(--dl-color-gold);
    flex-shrink: 0;
}
.hud-joueur__vie-piste {
    width: 226px;
    height: 21px;
    margin: 0 10px;
    border-radius: 11px;
    border-width: 1px;
    border-color: var(--dl-color-border);
    background-color: var(--dl-color-well);
    overflow: hidden;
}
.hud-joueur__vie-remplissage { height: 100%; width: 100%; border-radius: 11px; background-color: var(--dl-color-life); }
.hud-joueur__vie-valeur {
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
    font-size: 22px;
    color: var(--dl-color-text);
    margin: 0 0 0 3px;
    padding: 1px 8px;
    border-radius: 9px;
    background-color: rgba(0, 0, 0, 0.32);
}

.hud-joueur__endurance-piste {
    width: 226px;
    height: 6px;
    margin-top: 6px;
    margin-left: 25px;
    border-radius: 3px;
    background-color: rgba(16, 19, 27, 0.4);
    overflow: hidden;
    opacity: 0.3;
    transition-property: opacity;
    transition-duration: 0.25s;
}
.hud-joueur__endurance-piste--active { opacity: 1; }
.hud-joueur__endurance-remplissage { height: 100%; width: 100%; border-radius: 3px; background-color: var(--dl-color-stamina); }

/* ---------- Compétences (bas, au centre) ---------- */
.hud-competences {
    position: absolute;
    bottom: 33px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: flex-end;
}

.hud-emplacement { align-items: center; margin: 0 9px; }

.hud-emplacement__case {
    width: 96px;
    height: 96px;
    border-radius: 18px;
    border-width: 3px;
    border-color: var(--dl-color-border);
    background-color: var(--dl-color-panel);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 9px;
}

.hud-emplacement__case--prete { border-color: var(--dl-color-border-strong); }
.hud-emplacement__case--active { border-color: var(--dl-color-gold); background-color: #3a3420; }
.hud-emplacement__case--indisponible .hud-emplacement__abrev { color: var(--dl-color-text-disabled); }
.hud-emplacement__case--indisponible .hud-emplacement__icone { opacity: 0.45; }

.hud-emplacement__icone { position: absolute; left: 12px; top: 12px; right: 12px; bottom: 12px; -unity-background-scale-mode: scale-to-fit; }

.hud-emplacement__abrev {
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
    font-size: 33px;
    color: var(--dl-color-text);
    margin: 0;
    padding: 0;
}

.hud-emplacement__voile {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    background-color: rgba(10, 12, 18, 0.62);
}

.hud-emplacement__recharge {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-Bold-SDF.asset");
    font-size: 36px;
    color: #ffffff;
    margin: 0;
    padding: 0;
}

.hud-emplacement__invite { --dl-prompt-size: 40px; --dl-key-height: 28px; --dl-key-text: 15px; }
.hud-competences--mort { opacity: 0.45; }

/* ---------- Centre ---------- */
.hud-reticule {
    position: absolute;
    width: 36px;
    height: 36px;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
}

.hud-interaction { position: absolute; top: 678px; left: 50%; translate: -50% 0; height: 60px; border-radius: 30px; background-color: rgba(16, 19, 27, 0.82); }
.hud-or-porte { position: absolute; right: 48px; top: 105px; height: 54px; display: none; border-width: 2px; border-color: var(--dl-color-gold); }
.hud-donjon-alerte { position: absolute; top: 150px; left: 50%; translate: -50% 0; height: 60px; display: none; background-color: rgba(120, 30, 20, 0.9); border-width: 2px; border-color: #ff9a3c; }
.hud-donjon-alerte__texte { font-size: var(--dl-text-large); color: #ffffff; margin: 0; padding: 0; -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset"); }
.hud-donjon-message { position: absolute; top: 222px; left: 50%; translate: -50% 0; height: 54px; display: none; }
.hud-donjon-message__texte { font-size: var(--dl-text-body); color: var(--dl-color-gold); margin: 0; padding: 0; }
.dl-scale-3 .hud-or-porte { right: 24px; top: 88px; }
.dl-scale-3 .hud-donjon-alerte { top: 120px; }
.dl-scale-3 .hud-donjon-message { top: 188px; }
/* Au-dessus du bloc joueur (portrait 132 px + marge, maquette B) ; la rangée de statuts est maintenant dans le
   bloc, au-dessus de la barre de vie, donc la hauteur du bloc ne varie plus avec elle (HudStatuts.cs). */
.hud-points { position: absolute; left: 48px; bottom: 189px; height: 54px; display: none; border-width: 2px; border-color: var(--dl-color-gold); }
.hud-points__texte { font-size: var(--dl-text-body); color: var(--dl-color-gold); margin: 0 12px 0 0; padding: 0; -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset"); }
.dl-scale-3 .hud-points { left: 24px; bottom: 142px; }
.hud-interaction__texte { font-size: var(--dl-text-body); margin: 0 0 0 12px; padding: 0; }

/* ---------- Mort ---------- */
.hud-mort {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(28, 8, 10, 0.62);
}

.hud-mort__titre { font-size: 84px; color: #ffb3a8; }
.hud-mort__texte {
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
    font-size: 42px;
    color: var(--dl-color-gold);
    margin: 6px 0 12px 0;
    padding: 0;
}
.hud-mort__aide { font-size: var(--dl-text-body); }

/* ---------- Taille ×3 : le HUD tient dans ~1422 × 800 ---------- */
.dl-scale-3 .hud-haut { width: 720px; top: 20px; }   /* 620 avant le compteur de missiles */
.dl-scale-3 .hud-or { right: 24px; top: 20px; }
.dl-scale-3 .hud-or__legende { display: none; }
.dl-scale-3 .hud-joueur { left: 24px; bottom: 24px; }
.dl-scale-3 .hud-joueur__portrait-emplacement { width: 100px; height: 100px; margin-right: 15px; }
.dl-scale-3 .hud-joueur__portrait { left: 11px; top: 11px; right: 11px; bottom: 11px; }
.dl-scale-3 .hud-joueur__vie-piste, .dl-scale-3 .hud-joueur__endurance-piste { width: 170px; }
.dl-scale-3 .hud-competences { bottom: 24px; left: auto; right: 24px; translate: 0 0; }
.dl-scale-3 .hud-interaction { top: 480px; }
.dl-scale-3 .hud-banniere { top: 150px; }
.dl-scale-3 .hud-allies { left: 24px; top: 34%; width: 272px; }
.dl-scale-3 .hud-allie { height: 54px; padding: 0 15px 0 6px; margin-bottom: 6px; }
.dl-scale-3 .hud-allie__embleme { width: 39px; height: 39px; margin-right: 9px; }

/* ---------- Statuts (HudStatuts.cs, 26/09/2026 ; déplacés dans le bloc joueur le 26/09/2026, maquette B) ----------
   Rangée du joueur dans la colonne du bloc joueur, juste au-dessus de la barre de vie (la pastille des points de
   compétence reste au-dessus de tout le bloc, .hud-points). Pour la déplacer, changer seulement .hud-statuts.
   Petites rangées au-dessus des ennemis, placées comme les pseudos (calque à part, inchangé).
   Liseré rouge : affliction ; or : bienfait. Jauge de durée en bas de la case ; secondes dans la pastille (joueur). */
.hud-statuts { flex-direction: row; align-items: flex-end; margin-bottom: 9px; display: none; }
.statut {
    width: 60px;
    height: 60px;
    margin-right: 12px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--dl-color-life);
    background-color: rgba(16, 19, 27, 0.85);
}
.statut--bienfait { border-color: var(--dl-color-gold); }
.statut__icone { position: absolute; left: 6px; top: 4px; right: 6px; bottom: 10px; }
.statut__jauge { position: absolute; left: 7px; right: 7px; bottom: 4px; height: 5px; border-radius: 3px; background-color: var(--dl-color-well); overflow: hidden; }
.statut__jauge-remplie { height: 100%; width: 100%; background-color: var(--dl-color-text); }
.statut__temps {
    position: absolute;
    right: -9px;
    top: -12px;
    min-width: 27px;
    height: 27px;
    margin: 0;
    padding: 0 6px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--dl-color-border-strong);
    background-color: var(--dl-color-ink);
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
    font-size: var(--dl-text-caption);
    color: var(--dl-color-text);
}
.hud-statuts-ennemis { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hud-statuts-ennemi { position: absolute; translate: -50% -100%; flex-direction: row; align-items: flex-end; }
.statut--petit { width: 36px; height: 36px; margin: 0 2px; border-radius: 8px; background-color: rgba(16, 19, 27, 0.78); }
.statut--petit .statut__icone { left: 3px; top: 2px; right: 3px; bottom: 6px; }
.statut--petit .statut__jauge { left: 4px; right: 4px; bottom: 2px; height: 3px; border-radius: 2px; }

/* ---------- Jauge de parade du paladin (HudParade.cs, 26/09/2026) ----------
   Sous le réticule, seulement quand un coup parable vise le joueur. Impact prévu au bord droit, curseur ivoire qui
   avance vers lui ; fenêtre de parade en ivoire léger, fenêtre parfaite en or (palette Sacre) ; repère fin de l'appui.
   Issue : liseré or (parfaite, avec « Parfaite »), ivoire (parade), atténué (bloqué), rouge (touché). Ni vert ni icône. */
.hud-parade { position: absolute; left: 50%; top: 50%; width: 240px; height: 36px; margin-top: 40px; translate: -50% 0; }
.hud-parade__piste {
    position: absolute;
    left: 0;
    right: 0;
    top: 13px;
    height: 12px;
    border-radius: 6px;
    border-width: 2px;
    border-color: var(--dl-color-border-strong);
    background-color: rgba(16, 19, 27, 0.82);
    overflow: hidden;
}
.hud-parade__zone { position: absolute; right: 0; top: 0; bottom: 0; background-color: rgba(244, 236, 216, 0.4); }
.hud-parade__parfaite { position: absolute; right: 0; top: 0; bottom: 0; background-color: var(--dl-color-gold); }
.hud-parade__appui { position: absolute; top: 0; bottom: 0; width: 3px; translate: -50% 0; background-color: var(--dl-color-text-muted); }
.hud-parade__curseur {
    position: absolute;
    top: 6px;
    width: 6px;
    height: 26px;
    translate: -50% 0;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--dl-color-ink);
    background-color: var(--dl-color-text);
}
.hud-parade__texte {
    position: absolute;
    left: 50%;
    top: -30px;
    translate: -50% 0;
    display: none;
    margin: 0;
    padding: 0 12px;
    height: 27px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--dl-color-gold);
    background-color: rgba(16, 19, 27, 0.85);
    -unity-font-definition: url("/Assets/UI/Fonts/Fredoka-SemiBold-SDF.asset");
    font-size: var(--dl-text-caption);
    color: var(--dl-color-gold);
    -unity-text-align: middle-center;
}
.hud-parade--parfaite .hud-parade__piste { border-color: var(--dl-color-gold); }
.hud-parade--parfaite .hud-parade__curseur { background-color: var(--dl-color-gold); }
.hud-parade--parade .hud-parade__piste { border-color: var(--dl-color-text); }
.hud-parade--bloque .hud-parade__piste { border-color: var(--dl-color-text-disabled); }
.hud-parade--touche .hud-parade__piste { border-color: var(--dl-color-life); }

/* ---------- Jauge de relevé du Renversé (HudRelevage.cs, 26/09/2026) ----------
   Sous le héros local le temps qu'il est à terre (statut Renversé) : invite du bouton Saut à marteler, jauge de
   martelage en dessous qui se remplit à mesure qu'on approche le plafond (50 % de réduction au plus). Liseré rouge
   d'affliction (pas de vert). */
.hud-relevage { position: absolute; align-items: center; width: 60px; }
.hud-relevage__touche { margin-bottom: 3px; }
.hud-relevage__jauge {
    width: 54px;
    height: 7px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--dl-color-border-strong);
    background-color: var(--dl-color-well);
    overflow: hidden;
}
.hud-relevage__remplissage { height: 100%; width: 0%; background-color: var(--dl-color-life); }
